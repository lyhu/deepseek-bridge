{
  "manifest_version": 3,
  "name": "DeepSeek Web to API Bridge",
  "version": "0.2.0",
  "description": "一键将 DeepSeek 网页端代理为本地标准 OpenAI 接口，供 Bob、沉浸式翻译等客户端使用",
  "key": "",
  "permissions": [
    "tabs",
    "alarms",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "icons": {
    "16": "icons/icon-inactive-16.png",
    "32": "icons/icon-inactive-32.png",
    "48": "icons/icon-inactive-48.png",
    "128": "icons/icon-inactive-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-inactive-16.png",
      "32": "icons/icon-inactive-32.png",
      "48": "icons/icon-inactive-48.png",
      "128": "icons/icon-inactive-128.png"
    },
    "default_title": "DeepSeek 代理网关 (未启动)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
